// -*- mode: jsonc -*-
{
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 0,
    "margin-bottom": -10,

    "modules-left": [
        "hyprland/workspaces",
        "cpu",
        "memory",
        "custom/backup",
        "custom/mntbackup"
    ],
    "modules-center": [
        "hyprland/window"
    ],
    "modules-right": [
        "hyprland/submap",
        "custom/systemd",
        "custom/updates",
        "pulseaudio",
        "network",
        "clock",
        "custom/power"
    ],

    // Icons are wrapped in a muted span so values carry the visual weight.
    // Muted color: #565f89

    "hyprland/workspaces": {
        "format": "{name}"
    },
    "hyprland/window": {
        "format": "{title}",
        "max-length": 60,
        "separate-outputs": true,
        "rewrite": {
            "(.*) — Mozilla Firefox": "$1",
            "(.*)Firefox": "Firefox",
            "Alacritty": "Terminal",
            "(.*)Discord": "Discord",
            "World of Warcraft": "WoW"
        }
    },
    "hyprland/submap": {
        "format": "{}"
    },
    "cpu": {
        "format": "<span color='#565f89'>CPU</span> {usage:>2}%",
        "states": { "warning": 70, "critical": 90 },
        "on-click": "alacritty -e btop",
        "interval": 2
    },
    "memory": {
        "interval": 30,
        "format": "<span color='#565f89'>MEM</span> {used:0.1f}/{total:0.0f}G",
        "states": { "warning": 75, "critical": 90 },
        "tooltip-format": "{used:0.1f}G used of {total:0.1f}G ({percentage}%)",
        "on-click": "alacritty -e btop"
    },
    "custom/backup": {
        "interval": 300,
        "return-type": "json",
        "format": "<span color='#565f89'>/</span> {}",
        "exec": "~/.config/waybar/btrfs-disk-util.sh /",
        "on-click": "alacritty -e sh -c 'btrfs filesystem usage /; echo; echo \"Press enter to close...\"; read'"
    },
    "custom/mntbackup": {
        "interval": 300,
        "return-type": "json",
        "format": "<span color='#565f89'>BAK</span> {}",
        "exec": "~/.config/waybar/btrfs-disk-util.sh /mnt/backup",
        "on-click": "alacritty -e sh -c 'btrfs filesystem usage /mnt/backup; echo; echo \"Press enter to close...\"; read'"
    },
    "custom/systemd": {
        "format": "{}",
        "return-type": "json",
        "interval": 60,
        "exec": "~/.config/waybar/systemd-status.sh",
        "on-click": "alacritty -e journalctl -p 3 -xb",
        "escape": true
    },
    "custom/updates": {
        "format": "<span color='#565f89'>{icon}</span> {text}",
        "return-type": "json",
        "format-icons": {
            "has-updates": "󰚰",
            "updated": "󰚰",
            "error": "󰚰"
        },
        "tooltip": true,
        "interval": 600,
        // Refreshed immediately after pacman transactions by
        // pacman-hooks/waybar-updates.hook (pkill -RTMIN+8 waybar).
        "signal": 8,
        "exec": "~/.config/waybar/updates.sh",
        "on-click": "alacritty -e yay"
    },
    "pulseaudio": {
        "format": "<span color='#565f89'>{icon}</span> {volume}%",
        "format-muted": "<span color='#565f89'>󰝟</span> muted",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "pavucontrol"
    },
    "network": {
        "format-wifi": "󰤨",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰤭",
        "interval": 5,
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}",
        "tooltip-format-ethernet": "{ifname}\n{ipaddr}",
        "tooltip-format-disconnected": "Disconnected",
        "on-click": "alacritty -e impala"
    },
    "clock": {
        "timezone": "America/Los_Angeles",
        "format": "<span color='#565f89'>{:%a %b %d</span>  %I:%M %p}",
        "tooltip-format": "{:%A, %B %d %Y  %I:%M:%S %p}",
        "interval": 1
    },
    "custom/power": {
        "format": "⏻",
        "on-click": "nwg-bar",
        "tooltip": false
    }
}
